---
const links = [
  { label: "GitHub", href: "https://github.com/itsjustaplant" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/alperensahinn/",
  },
  { label: "Twitter", href: "https://twitter.com/justa_plant" },
  { label: "SoundCloud", href: "https://soundcloud.com/justaplant" },
];
const projects = [
  { label: "rexp", href: "https://github.com/itsjustaplant/rexp" },
  { label: "spofly", href: "https://github.com/itsjustaplant/spofly" },
  { label: "helios", href: "https://github.com/itsjustaplant/helios" },
  { label: "iris", href: "https://github.com/itsjustaplant/iris" },
];
---

<footer class="contact">
  <nav aria-labelledby="contacts-title">
    <h2 id="contacts-title">Contacts</h2>
    <ul>
      {
        links.map(({ label, href }) => (
          <li>
            <a
              class="text-link"
              href={href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {label}
              <span class="link-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <section aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    <ul>
      {
        projects.map(({ label, href }) => (
          <li>
            <a
              class="text-link"
              href={href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {label}
              <span class="link-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</footer>
