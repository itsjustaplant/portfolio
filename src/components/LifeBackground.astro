<div class="life-background" aria-hidden="true"><canvas></canvas></div>

<script>
  import { advanceLife } from "../lib/game-of-life";

  function mountLife(field: HTMLElement) {
    const canvas = field.querySelector("canvas")!;
    const context = canvas.getContext("2d");
    if (!context) return () => {};
    const ctx = context;
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const cellSize = 8;
    const bayer = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
    let cells = new Uint8Array(),
      next = new Uint8Array();
    let energy = new Float32Array();
    let columns = 0,
      rows = 0,
      width = 0,
      height = 0;
    let timer = 0,
      visible = false,
      quiet = 0,
      seed = 47;
    const random = () => {
      seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
      return seed / 4294967296;
    };

    function seedField() {
      for (let i = 0; i < cells.length; i++) cells[i] = random() < 0.27 ? 1 : 0;
      // Let the initial noise resolve into recognizable clusters before displaying it.
      for (let i = 0; i < 4; i++) {
        advanceLife(cells, next, columns, rows);
        [cells, next] = [next, cells];
      }
      quiet = 0;
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "#899b74";
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < columns; x++) {
          const i = y * columns + x;
          // Living cells stay stippled; fading cells leave a short, dissolving trail.
          energy[i] = cells[i] ? 0.65 : energy[i] * 0.72;
          if (energy[i] < 0.035) continue;
          for (let py = 0; py < 4; py++) {
            for (let px = 0; px < 4; px++) {
              if (energy[i] > (bayer[py * 4 + px] + 0.5) / 16) {
                ctx.fillRect(
                  x * cellSize + px * 2,
                  y * cellSize + py * 2,
                  1,
                  1,
                );
              }
            }
          }
        }
      }
    }

    function step() {
      const changed = advanceLife(cells, next, columns, rows);
      [cells, next] = [next, cells];
      quiet = changed < 5 ? quiet + 1 : 0;
      // Start a fresh field if it settles, so the background keeps evolving.
      if (quiet > 24) seedField();
      draw();
    }

    function resize() {
      const bounds = field.getBoundingClientRect();
      const newColumns = Math.max(3, Math.ceil(bounds.width / cellSize));
      const newRows = Math.max(3, Math.ceil(bounds.height / cellSize));
      width = bounds.width;
      height = bounds.height;
      const ratio = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      if (columns !== newColumns || rows !== newRows) {
        columns = newColumns;
        rows = newRows;
        cells = new Uint8Array(columns * rows);
        next = new Uint8Array(columns * rows);
        energy = new Float32Array(columns * rows);
        seedField();
      }
      draw();
    }

    function updateMotion() {
      window.clearInterval(timer);
      timer = 0;
      if (visible && !document.hidden && !motion.matches)
        timer = window.setInterval(step, 180);
    }
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updateMotion();
    });
    observer.observe(field);
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(field);
    motion.addEventListener("change", updateMotion);
    document.addEventListener("visibilitychange", updateMotion);
    resize();
    return () => {
      window.clearInterval(timer);
      observer.disconnect();
      resizeObserver.disconnect();
      motion.removeEventListener("change", updateMotion);
      document.removeEventListener("visibilitychange", updateMotion);
    };
  }

  let dispose: (() => void) | undefined;
  function initLife() {
    dispose?.();
    const field = document.querySelector<HTMLElement>(".life-background");
    dispose = field ? mountLife(field) : undefined;
  }
  document.addEventListener("astro:page-load", initLife);
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
</script>

<style>
  .life-background {
    position: absolute;
    z-index: -1;
    inset: -80px 0;
    overflow: hidden;
    opacity: 0.32;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
