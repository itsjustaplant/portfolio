---
import Link from "../components/Link";

const EducationData = [
  {
    date: "2018 — 2023",
    text: "Hacettepe University - Electrical and Electronics Engineering",
    link: "http://www.ee.hacettepe.edu.tr/",
    description:
      "Learned circuit theory, C, VHDL, signal processing, integrated circuit design and embedded system design.",
  },
  {
    date: "2016 — 2017",
    text: "Grand Valley State University",
    link: "https://www.gvsu.edu/",
    description:
      "Attended to Intensive English Program for Academic Purposes offered by ELS Language Center at Grand Rapids, MI.",
  },
];
---

<section class="resume-section" id="education" aria-labelledby="education-title">
  <div class="section-heading"><span class="section-index">02 /</span><h2 id="education-title">Education</h2><span class="section-rule"></span></div>
  <div class="resume-list">
    {EducationData.map(({ date, text, link, description }, i) => (
      <div class="resume-row">
        <div class="resume-date"><span class={i === 0 && 'Education' === 'Experience' ? 'current-dot' : 'timeline-dot'}></span>{date}</div>
        <div class="resume-content"><Link href={link} className="resume-title">{text}</Link><p>{description}</p></div>
      </div>
    ))}
  </div>
</section>
