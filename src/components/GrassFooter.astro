<div class="grass-footer" aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  function mountGrass(footer: HTMLElement) {
    const canvas = footer.querySelector("canvas")!;
    const context = canvas.getContext("2d");
    const field = document.createElement("canvas");
    const fieldContext = field.getContext("2d", { willReadFrequently: true });
    if (!context || !fieldContext) return () => {};
    const output = context;
    const ctx = fieldContext;
    const cellSize = 2;
    const bayer = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const colors = ["#242c23", "#3a4734", "#667653"];
    type Blade = {
      x: number;
      height: number;
      width: number;
      lean: number;
      phase: number;
      color: string;
    };
    let blades: Blade[] = [];
    let width = 0,
      height = 0,
      elapsed = 0,
      lastTime = 0,
      animation = 0;
    let visible = false;

    // A repeatable field keeps the grass from changing randomly on resize.
    function populate() {
      let seed = 27;
      const random = () => {
        seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
        return seed / 4294967296;
      };
      blades = [];
      for (let layer = 0; layer < 3; layer++) {
        const count = Math.ceil(width / (layer === 2 ? 5 : 7));
        for (let i = 0; i < count; i++) {
          blades.push({
            x: (i / count) * (width + 60) - 30 + random() * 9,
            height: height * (0.2 + random() * 0.65) * (1 - layer * 0.18),
            width: 1.5 + random() * (layer === 2 ? 2.2 : 1.7),
            lean: (random() - 0.5) * 28,
            phase: random() * Math.PI * 2,
            color: colors[layer],
          });
        }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);
      for (const blade of blades) {
        const { x, height: h, width: w, lean, phase, color } = blade;
        // A broad breeze travels across the field, with smaller individual motion.
        const wind = motion.matches
          ? 0
          : Math.sin(elapsed * 0.8 - x * 0.008) * 11 +
            Math.sin(elapsed * 1.5 + phase) * 3;
        const bend = lean + (wind * h) / height;
        const tipX = x + bend;
        const tipY = height - h;
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.moveTo(x - w / 2, height + 1);
        ctx.bezierCurveTo(
          x - w,
          height - h * 0.4,
          tipX - bend * 0.3,
          tipY + h * 0.2,
          tipX,
          tipY,
        );
        ctx.bezierCurveTo(
          tipX - bend * 0.15,
          tipY + h * 0.35,
          x + w,
          height - h * 0.25,
          x + w / 2,
          height + 1,
        );
        ctx.fill();
      }
      // Quantize the shaded field to the plant's pale ink and transparent pixels.
      const pixels = ctx.getImageData(0, 0, field.width, field.height);
      const data = pixels.data;
      for (let y = 0; y < field.height; y++) {
        for (let x = 0; x < field.width; x++) {
          const i = (y * field.width + x) * 4;
          if (!data[i + 3]) continue;
          const tone =
            (data[i] * 0.2126 + data[i + 1] * 0.7152 + data[i + 2] * 0.0722) /
            255;
          const coverage = (Math.min(1, tone * 1.6) * data[i + 3]) / 255;
          const threshold = (bayer[(y % 4) * 4 + (x % 4)] + 0.5) / 16;
          data[i] = 176;
          data[i + 1] = 199;
          data[i + 2] = 151;
          data[i + 3] = coverage > threshold ? 255 : 0;
        }
      }
      ctx.putImageData(pixels, 0, 0);
      output.clearRect(0, 0, width, height);
      output.drawImage(
        field,
        0,
        0,
        field.width * cellSize,
        field.height * cellSize,
      );
    }

    function resize() {
      const bounds = footer.getBoundingClientRect();
      width = bounds.width;
      height = bounds.height;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      output.setTransform(ratio, 0, 0, ratio, 0, 0);
      output.imageSmoothingEnabled = false;
      field.width = Math.ceil(width / cellSize);
      field.height = Math.ceil(height / cellSize);
      ctx.setTransform(1 / cellSize, 0, 0, 1 / cellSize, 0, 0);
      populate();
      draw();
    }

    function tick(time: number) {
      animation = 0;
      if (lastTime) elapsed += Math.min((time - lastTime) / 1000, 0.05);
      lastTime = time;
      draw();
      animation = requestAnimationFrame(tick);
    }

    function updateMotion() {
      cancelAnimationFrame(animation);
      animation = 0;
      lastTime = 0;
      if (visible && !document.hidden && !motion.matches) {
        animation = requestAnimationFrame(tick);
      } else {
        draw();
      }
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(footer);
    const viewObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updateMotion();
    });
    viewObserver.observe(footer);
    motion.addEventListener("change", updateMotion);
    document.addEventListener("visibilitychange", updateMotion);
    resize();

    return () => {
      cancelAnimationFrame(animation);
      resizeObserver.disconnect();
      viewObserver.disconnect();
      motion.removeEventListener("change", updateMotion);
      document.removeEventListener("visibilitychange", updateMotion);
    };
  }

  let dispose: (() => void) | undefined;
  function initGrass() {
    dispose?.();
    const footer = document.querySelector<HTMLElement>(".grass-footer");
    dispose = footer ? mountGrass(footer) : undefined;
  }
  document.addEventListener("astro:page-load", initGrass);
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
</script>

<style>
  .grass-footer {
    position: relative;
    flex-shrink: 0;
    width: 100%;
    height: clamp(110px, 18svh, 190px);
    margin-top: auto;
    overflow: hidden;
    pointer-events: none;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
