<div class="form-study" aria-label="Interactive monochrome generative sculpture">
  <span class="study-corner study-corner-tl">+</span><span class="study-corner study-corner-tr">+</span>
  <canvas width="700" height="650" aria-hidden="true"></canvas>
  <div class="study-label"><span class="study-dot"></span><span>just a little experiment</span><span class="study-number">001</span></div>
  <span class="study-corner study-corner-bl">+</span><span class="study-corner study-corner-br">+</span>
</div>
<script>
  function initSculpture() {
    document.querySelectorAll<HTMLCanvasElement>('.form-study canvas').forEach(canvas => {
      if (canvas.dataset.ready) return;
      canvas.dataset.ready = 'true';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const points: number[][] = [];
      // A torus knot, sampled into ink-like stippling rather than a solid mesh.
      for (let i = 0; i < 450; i++) {
        const t = i / 450 * Math.PI * 2;
        const center = (v: number) => [(2 + .66 * Math.cos(3*v))*Math.cos(2*v), (2 + .66*Math.cos(3*v))*Math.sin(2*v), .95*Math.sin(3*v)];
        const c = center(t), next = center(t+.001);
        const d = next.map((v,j) => v-c[j]);
        const len = Math.hypot(...d); const tangent = d.map(v=>v/len);
        const nlen = Math.hypot(tangent[0], tangent[1]);
        const n = [-tangent[1]/nlen,tangent[0]/nlen,0];
        const b = [tangent[1]*n[2]-tangent[2]*n[1], tangent[2]*n[0]-tangent[0]*n[2], tangent[0]*n[1]-tangent[1]*n[0]];
        for(let j=0;j<95;j++) {
          const a=j/95*Math.PI*2;
          points.push(c.map((v,k)=>v+.48*(Math.cos(a)*n[k]+Math.sin(a)*b[k])));
        }
      }
      function draw(rx=-.55, ry=.25) {
        if(!ctx) return;
        ctx.clearRect(0,0,700,650);
        const transformed = points.map(([x,y,z])=>{
          const yy=y*Math.cos(rx)-z*Math.sin(rx), zz=y*Math.sin(rx)+z*Math.cos(rx);
          return [x*Math.cos(ry)+zz*Math.sin(ry),yy,-x*Math.sin(ry)+zz*Math.cos(ry)];
        }).sort((a,b)=>a[2]-b[2]);
        transformed.forEach(([x,y,z])=>{
          const depth=(z+3.3)/6.6;
          ctx.fillStyle=`rgba(20,20,20,${.1+depth*.76})`;
          const scale=79*(1+z*.025);
          ctx.fillRect(350+x*scale,311+y*scale,depth>.55?1.45:1.05,depth>.55?1.45:1.05);
        });
      }
      draw();
      const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
      let frame=0;
      canvas.addEventListener('pointermove',e=>{
        if(reduced.matches || e.pointerType==='touch')return;
        cancelAnimationFrame(frame);
        const r=canvas.getBoundingClientRect();
        frame=requestAnimationFrame(()=>draw(-.55+(e.clientY-r.top-r.height/2)/r.height*.3,.25+(e.clientX-r.left-r.width/2)/r.width*.5));
      });
      canvas.addEventListener('pointerleave',()=>{cancelAnimationFrame(frame);draw();});
    });
  }
  initSculpture();
  document.addEventListener('astro:page-load',initSculpture);
</script>
